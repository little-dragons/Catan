{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!!**/dist", "!!**/*.json"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
        "indentWidth": 4
	},
    "html": {
        "experimentalFullSupportEnabled": true
    },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
            "style": {
                "noNonNullAssertion": "off"
            }
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
            "semicolons": "asNeeded"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
