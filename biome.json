{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!!**/dist", "!!**/*.json"]
	},
	"formatter": {
		"enabled": false,
		"indentStyle": "space",
        "indentWidth": 4,
        "trailingNewline": true,
        "bracketSameLine": true
	},
    "html": {
        "experimentalFullSupportEnabled": true
    },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
            "style": {
                "noNonNullAssertion": "off"
            }
		}
	},
	"javascript": {
		"formatter": {
            "enabled": false,
			"quoteStyle": "single",
            "semicolons": "asNeeded",
            "arrowParentheses": "asNeeded",
            "bracketSameLine": true,
            "lineWidth": 320,
            "operatorLinebreak": "before",
            "trailingCommas": "none"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
